# Copy this file to `.env` and fill in real values. dotenv loads from `.env` only.
# If your password or username contains special characters like `@` or `:` you
# must URL‑encode them (e.g. change `@` → `%40`).

MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
PORT=5000
JWT_SECRET=your_jwt_secret_here
ADMIN_SECRET=your_admin_secret_here
# optional defaults for auto‑created admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=supersecure
